# Configurações do Servidor
PORT=3000

# Conexão com Azure DevOps
AZURE_DEVOPS_ORG_URL=https://projetosmirassol1.visualstudio.com
AZURE_DEVOPS_PAT=SEU_TOKEN_PAT_AQUI

# Intervalo do Agendador de Sincronização (em minutos)
SYNC_INTERVAL_MINUTES=30

# Senha PIN de Acesso ao Painel de Curadoria / Administração
ADMIN_PIN=TROQUE_ESTE_PIN

# Chave secreta HMAC para assinatura de sessões e tokens (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_FORTE
